// Prisma schema — metadata DB for jobs, cost codes, budgets, change orders,
// billings. The hledger journal (separate repo) is the source of truth for
// money movement; this DB is the source of truth for job metadata.
// See BUILD-INSTRUCTIONS.md and ~/Downloads/construction-ledger-spec.md §3.1.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id            Int      @id @default(autoincrement())
  code          String   @unique // short slug used in hledger tags, e.g. "J2026-014"
  name          String
  clientName    String?
  contractValue Decimal?
  retainagePct  Decimal  @default(0.10)
  status        String   @default("active") // active | complete | archived
  startDate     DateTime?
  targetEndDate DateTime?
  notes         String?

  budgets      JobBudget[]
  changeOrders ChangeOrder[]
  billings     ProgressBilling[]
  bills        Bill[]
  laborEntries LaborEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CostCode {
  id          Int    @id @default(autoincrement())
  code        String @unique // e.g. "03-CONCRETE", "06-CARPENTRY"
  name        String
  csiDivision String?

  budgets      JobBudget[]
  bills        Bill[]
  laborEntries LaborEntry[]
}

model JobBudget {
  jobId          Int
  costCodeId     Int
  budgetedAmount Decimal
  revisedEstimate Decimal? // CFO's revised remaining-cost estimate, if it diverges from budgetedAmount

  job      Job      @relation(fields: [jobId], references: [id])
  costCode CostCode @relation(fields: [costCodeId], references: [id])

  @@id([jobId, costCodeId])
}

model ChangeOrder {
  id           Int       @id @default(autoincrement())
  jobId        Int
  coNumber     String?
  description  String?
  amount       Decimal // can be negative
  approvedDate DateTime?
  status       String    @default("pending") // pending | approved | rejected

  job Job @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
}

model ProgressBilling {
  id                  Int       @id @default(autoincrement())
  jobId               Int
  billingDate         DateTime?
  periodLabel         String? // "Pay App #4"
  amountBilled        Decimal
  retainageWithheld   Decimal
  paidAmount          Decimal   @default(0) // applied via PaymentApplication (v2 spec §F10)
  status              String    @default("unpaid") // unpaid | partial | paid
  pctCompleteEstimate Decimal? // CFO's own estimate for WIP calc
  txnid               String?   @unique // links to the journal entry that recorded this billing

  job      Job                   @relation(fields: [jobId], references: [id])
  payments PaymentApplication[]

  createdAt DateTime @default(now())
}

model PaymentApplication {
  id        Int      @id @default(autoincrement())
  billingId Int
  amount    Decimal
  date      DateTime
  txnid     String   @unique // the payment journal entry

  billing ProgressBilling @relation(fields: [billingId], references: [id])

  createdAt DateTime @default(now())
}

// --- Auth (V4 spec Phase 1) ---
// Standard Auth.js/NextAuth v5 Prisma-adapter schema (User/Account/Session/
// VerificationToken), confirmed field-for-field against
// node_modules/@auth/prisma-adapter/src/index.ts and
// node_modules/@auth/core/adapters.d.ts rather than assumed from memory.
// `role` is this app's own addition (Auth.js has no concept of roles) —
// copied onto the row from AllowedUser the first time each person signs in.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("viewer") // admin | bookkeeper | viewer

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Invite-only allowlist gate (product decision: single company, no public
// signup). Checked in the Auth.js `signIn` callback before a magic-link
// email is ever sent, not just after — an email that's never been added
// here never receives mail. `role` here is the role a newly-created User
// row is seeded with on first sign-in.
model AllowedUser {
  email String @id
  role  String @default("viewer") // admin | bookkeeper | viewer

  createdAt DateTime @default(now())
}

// Singleton (always id=1) — the result of the last `hledger check` run
// (V4 spec Phase 2: "check() was dead code"). Checked daily by
// /api/cron/verify-ledger and surfaced on the dashboard, so a corrupted or
// unbalanced journal is a visible "needs attention" state instead of a
// silent one.
model LedgerHealth {
  id            Int      @id @default(1)
  lastCheckedAt DateTime
  ok            Boolean
  error         String?
}

// Tracks every domain transaction (expense, payment, billing) that maps to a
// journal entry, keyed by the txnid tag written into the journal file. Enables
// idempotent edit/delete: look up the entry by txnid, not by re-parsing intent.
model JournalTxn {
  id        Int      @id @default(autoincrement())
  txnid     String   @unique
  jobId     Int?
  kind      String // expense | labor | payment | progress-billing | bill-payment | overhead-expense | opening-balance
  date      DateTime
  amount    Decimal
  memo      String?
  createdAt DateTime @default(now())
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  bills Bill[]
}

model OverheadCategory {
  id   Int    @id @default(autoincrement())
  code String @unique // e.g. "OFFICE", "INSURANCE", "FUEL"
  name String

  bills Bill[]
}

// A cash-holding account (checking, savings...). Opening balances are posted
// as a real journal entry against equity:opening balances so the dashboard's
// cash position reflects actual bank reality, not just journal activity
// since the app was set up (v2 spec §F8).
model CashAccount {
  id                  Int       @id @default(autoincrement())
  name                String    @unique // short slug used in the hledger account path, e.g. "checking"
  label               String // display label, e.g. "Operating Checking"
  isDefault           Boolean   @default(false)
  openingBalance      Decimal   @default(0)
  openingDate         DateTime?
  openingBalanceTxnid String? // the opening-balance journal entry, if the opening balance was ever nonzero — lets editOpeningBalance find it later (V4 spec Phase 2)
  createdAt           DateTime  @default(now())
}

// A vendor bill (job-cost or overhead). Created alongside the expense journal
// entry; tracks what's still owed so AP can actually be paid down (v2 spec
// §F2/§F6) instead of only ever growing.
model Bill {
  id                 Int       @id @default(autoincrement())
  vendorId           Int
  jobId              Int?
  costCodeId         Int?
  overheadCategoryId Int?
  amount             Decimal
  retainageWithheld  Decimal   @default(0) // withheld from this sub's bill, owed back later
  paidAmount         Decimal   @default(0)
  status             String    @default("open") // open | partial | paid
  date               DateTime
  description        String?
  costType           String? // labor | material | subcontract | equipment | other — required for job bills going forward (v3 spec §F17), NULL for overhead bills and pre-v3 entries until backfilled
  txnid              String    @unique // the expense journal entry that created this bill

  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  job              Job?              @relation(fields: [jobId], references: [id])
  costCode         CostCode?         @relation(fields: [costCodeId], references: [id])
  overheadCategory OverheadCategory? @relation(fields: [overheadCategoryId], references: [id])
  payments         BillPayment[]

  createdAt DateTime @default(now())
}

model BillPayment {
  id     Int      @id @default(autoincrement())
  billId Int
  amount Decimal
  date   DateTime
  txnid  String   @unique // the payment journal entry

  bill Bill @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())
}

// Company-wide labor-burden assumptions (v5 spec: "job costing" feature).
// Singleton (always id=1), same pattern as LedgerHealth. A real company's
// sick/holiday/hours-per-year conventions and employer payroll tax rates
// change rarely (a policy or tax-law update, not a per-employee thing) —
// admin-editable via /settings/labor-burden, never hardcoded.
model LaborBurdenSettings {
  id                   Int      @id @default(1)
  sickTimeAccrualPct   Decimal  @default(0.033) // 3.3%
  companyHolidayDays   Int      @default(13)
  avgHoursPerYear      Decimal  @default(2000)
  ficaPct              Decimal  @default(0.0765) // employer FICA match (Medicare + SS)
  futaPct              Decimal  @default(0.006) // Federal Unemployment
  stateUnemploymentPct Decimal  @default(0.013)
  updatedAt            DateTime @updatedAt
}

// Workers' comp classification rate table (v5 spec). A real company's WC
// rates are revised yearly at insurance renewal — admin-editable list, not
// hardcoded constants. Employee.wcCodeId is a live FK (not a copied rate)
// so a renewal-time rate change automatically re-prices every employee's
// *going-forward* burden; LaborEntry already snapshots the resolved dollar
// amount at record time, so past entries stay protected regardless.
model WorkersCompRate {
  id          Int      @id @default(autoincrement())
  code        String   @unique // insurer-assigned WC class code, e.g. "5645"; "0" for EXEMPT
  description String // e.g. "Carpentry", "EXEMPT"
  rate        Decimal // decimal fraction, e.g. 0.041472 for 4.1472%
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  employees Employee[]
}

// PTO accrual tiers keyed by tenure-year threshold (v5 spec), e.g.
// minTenureYears 0/1/2/5 -> 1%/2.2%/4.2%/6.2%. An employee's accrual rate
// is the highest tier whose minTenureYears is <= their tenure ("5+ years"
// applies from year 5 onward, or forever if no higher tier exists).
model PtoAccrualTier {
  id             Int     @id @default(autoincrement())
  minTenureYears Int     @unique
  accrualPct     Decimal
}

// v5 spec (job costing): burdenedRate is not stored here — it's computed
// (lib/labor-burden.ts) at entry time from these fields + LaborBurdenSettings
// + the employee's WorkersCompRate, and snapshotted onto the LaborEntry row,
// so a later rate/assumption change never rewrites the cost of past work.
// number/jobTitle/startDate/wcCodeId are nullable because existing employee
// rows predate this feature and can't be backfilled with real data
// automatically — real values get entered post-deploy via the admin-only
// employee edit form. A null wcCodeId resolves to a 0% WC rate in
// lib/labor-burden.ts (unclassified, not silently defaulted to some real
// trade); a null startDate is treated as zero tenure by the same module's
// caller.
model Employee {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  number                String?  @unique // employee ID, free text (matches Job.code's slug precedent)
  jobTitle              String? // free text, internal title ladder — not construction-cost-code related
  payType               String   @default("hourly") // "salary" | "hourly"
  employmentType        String   @default("full_time") // "full_time" | "part_time" | "seasonal" | "intern"
  wcCodeId              Int?
  startDate             DateTime?
  holidayDays           Int? // per-employee override; null = inherit LaborBurdenSettings.companyHolidayDays
  discretionaryPtoHours Decimal  @default(0)
  currentPay            Decimal  @default(0) // $/yr if payType="salary", $/hr if payType="hourly"
  healthInsMonthly      Decimal  @default(0)
  retirementPct         Decimal  @default(0)
  yearlyVehicleValue    Decimal  @default(0)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())

  wcCode       WorkersCompRate? @relation(fields: [wcCodeId], references: [id])
  laborEntries LaborEntry[]
}

// A burdened labor cost posted against a job/cost code. Mirrors Bill's role
// for expenses: the Prisma-side record paired 1:1 with a journal entry
// (kind: "labor"), keyed by txnid so edit/delete can find it without
// re-parsing the journal (v3 spec §F18/§F19).
model LaborEntry {
  id             Int      @id @default(autoincrement())
  txnid          String   @unique
  employeeId     Int
  jobId          Int
  costCodeId     Int
  date           DateTime
  hours          Decimal
  baseRate       Decimal // snapshot from Employee at entry time
  burdenedRate   Decimal // snapshot from Employee at entry time
  grossAmount    Decimal // baseRate * hours — display only, not posted
  burdenedAmount Decimal // burdenedRate * hours — the amount posted to the journal
  memo           String?

  employee Employee @relation(fields: [employeeId], references: [id])
  job      Job      @relation(fields: [jobId], references: [id])
  costCode CostCode @relation(fields: [costCodeId], references: [id])

  createdAt DateTime @default(now())
}
